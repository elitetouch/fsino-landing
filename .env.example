# Backend API host — the marketing pricing page fetches from
# /api/v1/billing/prices + /api/v1/billing/device-prices to render
# live token + hardware prices. If unset, pricing falls back to a
# soft "contact us" state.
NEXT_PUBLIC_API_BASE_URL=https://api.fsinnovation.net

# Support contact channels — mirror what's on the tenant portal so
# users see the same phone / hours / WhatsApp everywhere.
NEXT_PUBLIC_SUPPORT_PHONE=+2348083607945
NEXT_PUBLIC_SUPPORT_HOURS=Weekdays 9am to 6pm WAT
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/replace-with-real-invite-code

# Tenant portal URL — where "Log in" and "Get started" CTAs point.
NEXT_PUBLIC_TENANT_APP_URL=https://web.fsinnovation.net
